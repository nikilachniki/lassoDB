{
  "@context": {
    "@version": 1.1,

    "melod": "https://lod.academy/melod/vocab/ontology#",
    "terms": "https://lod.academy/melod/vocab/terms#",
    "lrmoo": "http://iflastandards.info/ns/lrm/lrmoo/",
    "cidoc": "http://www.cidoc-crm.org/cidoc-crm/",
    "mus": "http://data.doremus.org/ontology#",
    "schema": "https://schema.org/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "wv": "https://example.org/werkverzeichnis/ns#",

    "works": "urn:uuid:works/",
    "expressions": "urn:uuid:expressions/",
    "manifestations": "urn:uuid:manifestations/",
    "items": "urn:uuid:items/",
    "persons": "urn:uuid:persons/",
    "institutions": "urn:uuid:institutions/",
    "places": "urn:uuid:places/",
    "instrumentations": "urn:uuid:instrumentations/",
    "bibliography": "urn:uuid:bibliography/",

    "entries": "@graph",

    "Catalogue": "melod:DataCatalog",
    "Work": "melod:Work",
    "Expression": "melod:Expression",
    "Manifestation": "melod:Manifestation",
    "Item": "melod:Item",
    "Person": "melod:Person",
    "Institution": "melod:Institution",
    "Place": "melod:Place",
    "Instrumentation": "melod:Instrumentation",
    "Bibliography": "melod:Bibliography",

    "label": "rdfs:label",
    "titles": { "@id": "melod:hasTitle", "@container": "@set" },
    "text": { "@id": "rdfs:label", "@container": "@language" },
    "type": { "@id": "melod:hasTitleType", "@type": "@id" },

    "identifiers": { "@id": "melod:hasIdentifier", "@container": "@set" },
    "list": "rdfs:label",
    "value": { "@id": "owl:hasValue", "@type": "xsd:string" },

    "contributors": { "@id": "melod:hasContribution", "@container": "@set" },
    "agent": { "@id": "melod:hasAgent", "@type": "@id" },
    "role": { "@id": "melod:hasRole", "@type": "@id" },
    "certainty": { "@id": "melod:hasCertainty", "@type": "@id" },

    "notes": { "@id": "melod:hasAnnotation", "@container": "@set" },
    "html": { "@id": "melod:paragraph", "@type": "rdf:HTML" },

    "sameAs": { "@id": "owl:sameAs", "@type": "@id", "@container": "@set" },

    "status": "schema:creativeWorkStatus",
    "genres": { "@id": "wv:genre", "@container": "@set" },
    "textSources": { "@id": "wv:textSource", "@container": "@set" },
    "realisedIn": { "@id": "lrmoo:R3_is_realised_in", "@type": "@id", "@container": "@set" },
    "partOfWork": { "@id": "melod:isWorkPartOf", "@type": "@id" },
    "citations": { "@id": "wv:citation", "@container": "@set" },
    "inBibliography": { "@id": "wv:inBibliography", "@type": "@id" },
    "number": "wv:number",
    "page": { "@id": "wv:page", "@type": "xsd:integer" },
    "section": "wv:section",

    "languages": { "@id": "melod:inLanguage", "@type": "@id", "@container": "@set" },
    "instrumentation": { "@id": "melod:hasInstrumentation", "@type": "@id" },
    "partOfExpression": { "@id": "melod:isExpressionPartOf", "@type": "@id" },
    "key": "mus:U11_has_key",
    "pitch": { "@id": "melod:hasPitch", "@type": "@id" },
    "accidental": { "@id": "melod:hasAccidental", "@type": "@id" },
    "mode": { "@id": "melod:isInMode", "@type": "@id" },
    "meter": "melod:hasMeter",
    "meterCount": { "@id": "melod:hasMeterCount", "@type": "xsd:integer" },
    "meterUnit": { "@id": "melod:inMeterUnit", "@type": "xsd:integer" },
    "meterSymbol": "melod:usesMeterSymbol",
    "tempo": "melod:hasTempo",
    "duration": "melod:hasDuration",
    "incipit": "melod:hasIncipit",
    "pae": "melod:hasIncipitValue",
    "incipitText": { "@id": "melod:hasIncipitText", "@container": "@language" },
    "dateCreated": "schema:dateCreated",
    "placeCreated": { "@id": "schema:locationCreated", "@type": "@id" },
    "date": { "@id": "melod:isodate", "@type": "xsd:date" },
    "description": "schema:description",

    "classifications": { "@id": "melod:hasClassification", "@type": "@id", "@container": "@set" },
    "titlePages": { "@id": "melod:hasTitlePage", "@container": "@set" },
    "publication": "schema:publication",
    "startDate": { "@id": "schema:startDate", "@type": "xsd:date" },
    "endDate": { "@id": "schema:endDate", "@type": "xsd:date" },
    "place": { "@id": "schema:location", "@type": "@id" },
    "publisherName": "wv:publisherName",
    "sourceType": "wv:sourceType",
    "partbooks": "wv:partbooks",
    "dating": "wv:dating",
    "literature": { "@id": "wv:literature", "@container": "@set" },
    "partOfManifestation": { "@id": "melod:isManifestationPartOf", "@type": "@id" },
    "contents": { "@id": "wv:contents", "@container": "@list" },
    "position": "schema:position",
    "part": "wv:part",
    "embodies": { "@id": "lrmoo:R4_embodies", "@type": "@id" },
    "titleInSource": "wv:titleInSource",
    "voices": { "@id": "wv:voices", "@type": "xsd:integer" },
    "note": "wv:note",

    "keeper": { "@id": "cidoc:P50_has_current_keeper", "@type": "@id" },
    "shelfmark": "melod:hasShelfmark",
    "formerShelfmark": "melod:hasFormerShelfmark",
    "exemplifies": { "@id": "lrmoo:R7_exemplifies", "@type": "@id" },

    "familyName": "schema:familyName",
    "givenName": "schema:givenName",
    "alternateNames": { "@id": "schema:alternateName", "@container": "@set" },
    "birthDate": "schema:birthDate",
    "deathDate": "schema:deathDate",
    "birthPlace": { "@id": "schema:birthPlace", "@type": "@id" },
    "deathPlace": { "@id": "schema:deathPlace", "@type": "@id" },
    "occupations": { "@id": "schema:hasOccupation", "@container": "@set" },

    "name": "schema:name",
    "siglum": "melod:hasSiglum",
    "abbreviation": "melod:hasAbbreviation",
    "country": { "@id": "schema:containedInPlace", "@type": "@id" },

    "details": { "@id": "melod:hasInstrumentationDetail", "@container": "@set" },
    "medium": { "@id": "mus:U2_foresees_use_of_medium_of_performance", "@type": "@id" },
    "quantity": { "@id": "mus:U30_foresees_quantity_of_medium_of_performance", "@type": "xsd:integer" },

    "genre": { "@id": "schema:genre", "@type": "@id" },
    "authors": { "@id": "schema:author", "@type": "@id", "@container": "@set" },
    "editors": { "@id": "melod:hasEditor", "@type": "@id", "@container": "@set" },
    "series": { "@id": "schema:isPartOf", "@type": "@id" },
    "volumeNumber": "schema:position",
    "pagination": "schema:pagination",

    "composer": { "@id": "wv:composer", "@type": "@id" },
    "catalogueAbbreviation": "wv:catalogueAbbreviation"
  }
}
